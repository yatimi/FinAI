    "spendingBreakdownExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows this month’s expenses minus refunds, from highest to lowest. Refunds reduce spending in the month and category where they were recorded. Merchants use their saved names. Transfers, income, adjustments and unknown transactions are excluded."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрати цього місяця за вирахуванням повернень коштів, від найбільших до найменших. Повернення зменшують витрати в місяці й категорії, де їх записано. Використовуються збережені назви продавців. Перекази, доходи, коригування й невідомі операції виключено."
          }
        }
      }
    },
    "staleRecurringPaymentExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expected date has passed, but no matching payment is saved. The payment may have stopped or changed, or it may be missing from your imports."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікувана дата минула, але відповідного платежу немає. Платежі могли припинитися чи змінитися або платіж не потрапив до імпорту."
          }
        }
      }
    },
