    "forecastMethodExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An end-of-day estimate. Last month’s ordinary expenses are averaged over its calendar days and applied from tomorrow to month end. Active detected recurring expenses use their expected dates instead. Total income is assumed to match last month, or recorded income if higher."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінка станом на кінець дня. Звичайні витрати минулого місяця усереднюються за його календарними днями й застосовуються від завтра до кінця місяця. Для активних регулярних витрат використовуються очікувані дати. Загальний дохід вважається рівним доходу минулого місяця або вже збереженому доходу, якщо той більший."
          }
        }
      }
    },
    "forecastLimitations": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assumes complete imports and unchanged habits and income. A record does not prove the month is complete. Missing payments, changed prices and irregular income can make this estimate inaccurate. Recurring payments need three matching occurrences; stale patterns are not scheduled. No future refunds or transactions dated after today are included. Transfers, adjustments and unknown entries are excluded. Net spending is expenses minus recorded refunds; net flow is income minus net spending. This is not an account balance, available money or an affordability assessment. Currencies stay separate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Припускається повнота імпорту й незмінність звичок та доходів. Наявність запису не доводить повноти місяця. Пропущені платежі, зміни цін і нерегулярні доходи можуть знизити точність. Для регулярних платежів потрібні три збіги; прострочені закономірності не плануються. Майбутні повернення й операції після сьогодні не враховуються. Перекази, коригування й невідомі записи виключено. Чисті витрати — витрати мінус збережені повернення; чистий потік — доходи мінус чисті витрати. Це не баланс рахунку, доступні кошти чи оцінка фінансової спроможності. Валюти враховуються окремо."
          }
        }
      }
    },
    "forecastSummaryExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on last month’s recorded activity. Assumes complete imports and unchanged habits and income. Estimates are not available balances."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На основі збережених операцій минулого місяця. Припускається повнота імпорту й незмінність звичок та доходів. Оцінки не є доступними залишками."
          }
        }
      }
    },
