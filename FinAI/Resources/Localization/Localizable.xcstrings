    "budgetPlanningExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a monthly limit for each category across all accounts. Refunds in the same currency reduce this month’s spending; transfers and income are excluded. Limits repeat each calendar month. Budgets do not move money or convert currencies."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Установіть місячний ліміт категорії для всіх рахунків. Повернення в тій самій валюті зменшують витрати цього місяця; перекази й доходи виключено. Ліміти повторюються щомісяця. Бюджети не переміщують кошти й не конвертують валюти."
          }
        }
      },
      "extractionState": "manual"
    },
