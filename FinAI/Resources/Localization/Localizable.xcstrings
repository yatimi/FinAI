    "settingsAppearanceExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System matches your device’s appearance. Your choice is saved on this device."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системна тема відповідає темі пристрою. Ваш вибір зберігається на цьому пристрої."
          }
        }
      }
    },
    "settingsLanguage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мова"
          }
        }
      }
    },
    "settingsOpenLanguage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change language"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінити мову"
          }
        }
      }
    },
    "settingsLanguageExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose English or Ukrainian in Settings."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть англійську або українську в налаштуваннях."
          }
        }
      }
    },
    "settingsLanguageUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open Settings. Open Settings and select FinAI to change the app language."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити налаштування. Відкрийте їх і виберіть FinAI, щоб змінити мову програми."
          }
        }
      }
    },
    "settingsPrivacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватність"
          }
        }
      }
    },
    "privacyLocalTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored on your device"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збереження на пристрої"
          }
        }
      }
    },
    "privacyLocalDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your financial data is stored on this device. No account or bank connection is required. FinAI does not send your data to a server, track your activity or sync your financial records across devices."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші фінансові дані зберігаються на цьому пристрої. Обліковий запис і підключення до банку не потрібні. FinAI не надсилає дані на сервер, не відстежує вашу активність і не синхронізує фінансові записи між пристроями."
          }
        }
      }
    },
    "privacyAssistantTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device assistant"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистент на пристрої"
          }
        }
      }
    },
    "privacyAssistantDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence can help understand your questions on this device. It does not receive your financial records. FinAI calculates the answers on your device and does not save questions or answers. Suggested questions work without Apple Intelligence."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence може допомогти зрозуміти ваші запитання на цьому пристрої. Фінансові записи йому не передаються. FinAI обчислює відповіді на пристрої й не зберігає запитання чи відповіді. Запропоновані запитання працюють без Apple Intelligence."
          }
        }
      }
    },
    "privacyBackupTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device backups"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервні копії пристрою"
          }
        }
      }
    },
    "privacyBackupDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device backups may include your FinAI data, including in iCloud if you use iCloud Backup. Manage backups in Settings."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервні копії пристрою можуть містити дані FinAI, зокрема в iCloud, якщо ви використовуєте резервне копіювання iCloud. Керуйте резервними копіями в налаштуваннях."
          }
        }
      }
    },
    "privacyProtectionTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the app is inactive"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли програма неактивна"
          }
        }
      }
    },
    "privacyProtectionDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FinAI hides financial details when you leave the app. Its data files use iOS protection that restricts access while the device is locked. FinAI has no separate app lock and does not prevent screenshots while you use it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "FinAI приховує фінансові дані, коли ви залишаєте програму. Файли даних захищені засобами iOS, які обмежують доступ, коли пристрій заблоковано. FinAI не має окремого блокування програми й не забороняє знімки екрана під час користування."
          }
        }
      }
    },
    "privacyImportTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported files"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортовані файли"
          }
        }
      }
    },
    "privacyImportDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are processed on this device. Transactions are saved only after you confirm. FinAI does not keep a copy of the original file or change it. Selecting a cloud file in Files may download it to your device."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли обробляються на цьому пристрої. Операції зберігаються лише після підтвердження. FinAI не зберігає копії початкового файлу й не змінює його. Вибір хмарного файлу в програмі «Файли» може завантажити його на пристрій."
          }
        }
      }
    }
  },
  "version": "1.0"
}
