      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Net spending is expenses minus refunds. Net flow is income minus net spending. Transfers, adjustments and unknown transactions are excluded. These totals are not account balances."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чисті витрати — це витрати мінус повернення коштів. Чистий потік — це доходи мінус чисті витрати. Перекази, коригування й невідомі операції виключено. Ці підсумки не є залишками на рахунках."
