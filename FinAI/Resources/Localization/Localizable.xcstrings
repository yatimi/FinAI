            "value": "Assistant"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистент"
          }
        }
      }
    },
    "assistantFollowUp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow up"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уточнення"
          }
        }
      }
    },
    "assistantFollowUpExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch months without changing the category or excluded merchant. Choose “Without rent” to select whose payments to leave out."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикайте місяці зі збереженням категорії й виключеного продавця. Виберіть «Без оренди», щоб указати, чиї платежі не враховувати."
          }
        }
      }
    },
    "assistantFollowUpLastMonth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And last month?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "А за минулий місяць?"
          }
        }
      }
    },
    "assistantFollowUpThisMonth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And this month?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "А за цей місяць?"
          }
        }
      }
    },
    "assistantFollowUpTextExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggested questions and phrases like “How much did I spend on groceries?” work without Apple Intelligence. After an answer, try “And last month?”, “And this month?” or “And without rent?”. For rent, you’ll choose whose payments to leave out."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запропоновані запитання й фрази на зразок «Скільки я витратив на продукти?» працюють без Apple Intelligence. Після відповіді спробуйте «А за минулий місяць?», «А за цей місяць?» або «А без оренди?». Для оренди потрібно вибрати, чиї платежі не враховувати."
          }
        }
      }
    },
    "assistantIntroduction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about spending this month or last month. Compare months or explore a category or merchant. Follow-up questions keep your category and excluded merchant when you switch months."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитайте про витрати цього або минулого місяця. Порівняйте місяці чи перегляньте витрати за категорією або продавцем. Під час зміни місяця уточнення зберігають вибрану категорію й виключеного продавця."
          }
        }
      }
    },
    "assistantPrivacyExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions are processed on this device. Calculations use saved transactions; questions and answers are not saved."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
