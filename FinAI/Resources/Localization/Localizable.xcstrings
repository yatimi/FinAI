            "value": "System"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системна"
          }
        }
      }
    },
    "appearanceLight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Світла"
          }
        }
      }
    },
    "appearanceDark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Темна"
          }
        }
      }
    },
    "settingsAppearanceExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System follows your device appearance. Your choice is saved on this device."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системна тема відповідає темі пристрою. Ваш вибір зберігається на цьому пристрої."
          }
        }
      }
    },
    "settingsLanguage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мова"
          }
        }
      }
    },
    "settingsOpenLanguage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open iOS language settings"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити налаштування мови в iOS"
          }
        }
      }
    },
    "settingsLanguageExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FinAI supports English and Ukrainian. Choose the app language in iOS Settings. Your regional number, currency and date formats are kept."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "FinAI підтримує англійську й українську. Виберіть мову програми в налаштуваннях iOS. Регіональні формати чисел, валют і дат зберігаються."
          }
        }
      }
    },
    "settingsLanguageUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open Settings. Open the iOS Settings app and find FinAI to change its language."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити налаштування. Відкрийте програму «Параметри» iOS і знайдіть FinAI, щоб змінити мову."
          }
        }
      }
    },
    "settingsPrivacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватність"
          }
        }
      }
    },
    "privacyLocalTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored on your device"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збереження на пристрої"
          }
        }
      }
    },
    "privacyLocalDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FinAI stores your financial data locally. There is no required account, custom backend, bank connection or analytics service. FinAI does not sync your database with CloudKit."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "FinAI зберігає фінансові дані локально. Обліковий запис не потрібен; немає власного сервера, підключення до банку чи служби аналітики. FinAI не синхронізує базу даних із CloudKit."
          }
        }
      }
    },
    "privacyAssistantTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device assistant"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистент на пристрої"
          }
        }
      }
    },
    "privacyAssistantDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When available, Apple’s on-device model interprets your question. Financial records are not sent to the model. Swift code performs the calculations locally. Questions and answers are not saved. Suggested questions work without Apple Intelligence."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли доступна, модель Apple на пристрої розпізнає ваше запитання. Фінансові записи не передаються моделі. Код Swift виконує обчислення локально. Запитання й відповіді не зберігаються. Запропоновані запитання працюють без Apple Intelligence."
          }
        }
      }
    },
    "privacyBackupTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device backups"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервні копії пристрою"
          }
        }
      }
    },
    "privacyBackupDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System backups may include FinAI data, depending on your device and iCloud backup settings. Manage those backups in iOS Settings. Local storage does not mean your system backups stay on this device."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системні резервні копії можуть містити дані FinAI залежно від налаштувань пристрою й резервного копіювання iCloud. Керуйте ними в налаштуваннях iOS. Локальне збереження не означає, що системні резервні копії залишаються на цьому пристрої."
          }
        }
      }
    },
    "privacyProtectionTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the app is inactive"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли програма неактивна"
          }
        }
      }
    },
    "privacyProtectionDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FinAI covers financial details while inactive and uses iOS Complete Data Protection for its database files. This is not a separate app lock and does not block screenshots while you are using the app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "FinAI приховує фінансові дані, коли програма неактивна, і використовує iOS Complete Data Protection для файлів бази даних. Це не окреме блокування програми; знімки екрана під час користування не блокуються."
          }
        }
      }
    },
    "privacyImportTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported files"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортовані файли"
          }
        }
      }
    },
    "privacyImportDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imports are processed on this device and saved only after confirmation. FinAI does not retain a copy of the source file or change it. Choosing a file from a cloud provider in Files may download it to your device."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпорт обробляється на цьому пристрої й зберігається лише після підтвердження. FinAI не зберігає копії початкового файлу й не змінює його. Вибір файлу хмарного провайдера в програмі «Файли» може завантажити його на пристрій."
          }
        }
      }
    }
  },
  "version": "1.0"
}
