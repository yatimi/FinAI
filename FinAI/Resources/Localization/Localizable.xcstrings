    "spendingDrilldownExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expenses minus refunds in this month and currency. Tap a transaction to inspect or correct it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрати мінус повернення коштів за цей місяць у цій валюті. Торкніться операції, щоб переглянути чи виправити її."
          }
        }
      }
    },
