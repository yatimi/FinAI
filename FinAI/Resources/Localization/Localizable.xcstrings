    "debtExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record money you owe or lent to someone. Repayments reduce this debt only; they do not create bank transactions or change income, spending or account balances. Saved debts and repayments cannot be edited or deleted yet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте кошти, які ви винні або позичили іншій особі. Погашення зменшує лише цей борг; воно не створює банківських операцій і не змінює доходи, витрати чи баланси рахунків. Збережені борги й погашення поки не можна редагувати або видаляти."
          }
        }
      }
    },
