    "debtExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record money you owe or have lent. Repayments reduce only this debt. They do not create bank transactions or change income, spending or account balances. You can’t edit or delete saved debts or repayments yet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте гроші, які ви винні або позичили іншій людині. Погашення зменшують лише цей борг. Вони не створюють банківських операцій і не змінюють доходи, витрати чи баланси рахунків. Збережені борги й погашення поки не можна редагувати або видаляти."
          }
        }
      }
    },
