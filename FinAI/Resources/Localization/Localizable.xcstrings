    "merchantRuleMatchingExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matching ignores case, punctuation and spacing, and uses whole words. A short prefix can match many transactions; review every suggestion."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зіставлення не враховує регістр, розділові знаки й пробіли та використовує цілі слова. Короткий початок опису може відповідати багатьом операціям; перевіряйте кожну пропозицію."
          }
        }
      }
    },
    "merchantRules": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merchant rules"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила продавців"
          }
        }
      }
    },
    "merchantRulesExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules run locally before built-in suggestions. They apply to future previews only. Exact descriptions take priority, then the longest prefix. Transaction types, amounts and currencies stay unchanged."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила виконуються локально перед вбудованими пропозиціями й діють лише для майбутніх попередніх переглядів. Спочатку перевіряються точні описи, потім найдовший початок опису. Типи операцій, суми й валюти не змінюються."
          }
        }
      }
    },
    "merchantSuggestionsExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known merchants and categories are suggested locally. Review and correct them before saving. Changing the transaction type resets its category suggestion."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відомі продавці й категорії пропонуються локально. Перевірте та виправте їх перед збереженням. Зміна типу операції скидає запропоновану категорію."
          }
        }
      }
    },
