        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити борги. Збережені дані не замінено."
          }
        }
      }
    },
    "debtsSaveFailure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save this debt or repayment. Your edits are still here. Try again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти борг або погашення. Введені дані залишилися на екрані. Спробуйте ще раз."
          }
        }
      }
    },
    "debtInvalidInput": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a name, an amount greater than zero and a supported currency. Debt and repayment dates can’t be in the future. A repayment must be on or after the debt date and no more than the remaining debt. The due date must be on or after the debt date."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ім’я, суму більшу за нуль і підтримувану валюту. Дати боргу й погашення не можуть бути майбутніми. Дата погашення має бути не раніше дати боргу, а сума — не більшою за залишок. Строк повернення має бути не раніше дати боргу."
          }
        }
      }
    },
    "debtChangedFailure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This debt changed. Cancel editing and reload before recording another repayment."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей борг змінився. Скасуйте редагування й оновіть дані перед записом наступного погашення."
          }
        }
      }
    },
    "assistantCategoryQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending by category"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрати за категоріями"
          }
        }
      }
    },
    "assistantWithoutRent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without rent…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без оренди…"
          }
        }
      }
    },
    "assistantChooseRentMerchant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who do you pay rent to?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кому ви сплачуєте оренду?"
          }
        }
      }
    },
    "assistantRentMerchantExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the recipient of your rent payments. All expenses and refunds for this merchant will be excluded, even payments unrelated to rent. Other Housing transactions stay included."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть отримувача орендної плати. Усі витрати й повернення коштів для цього продавця буде виключено, навіть не пов’язані з орендою. Інші операції категорії «Житло» враховуватимуться."
          }
        }
      }
    },
    "assistantExcludedMerchant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded merchant"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виключений продавець"
          }
        }
      }
    },
    "assistantExclusionExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All recorded expenses and refunds at this saved merchant are excluded. Other housing transactions remain included."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі збережені витрати й повернення коштів у цього продавця виключено. Інші операції за житло враховуються."
          }
        }
      }
    },
    "assistantRemoveExclusion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include this merchant"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Враховувати цього продавця"
          }
        }
      }
    },
    "privacyPreviewHidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Financial details are hidden while the app is inactive."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фінансові дані приховано, поки програма неактивна."
          }
        }
      }
    },
