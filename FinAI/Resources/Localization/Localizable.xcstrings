    "recurringDetectionExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible recurring expenses, not confirmed contracts. Matching uses at least three equal payments to the same saved merchant, on one account and in one currency. Weekly dates may vary by one day; monthly and yearly dates by three days."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можливі регулярні витрати, а не підтверджені договори. Зіставлення потребує щонайменше трьох однакових платежів тому самому збереженому продавцю з одного рахунку в одній валюті. Щотижневі дати можуть відрізнятися на один день; щомісячні та щорічні — на три дні."
          }
        }
      }
    },
    "recurringEstimateExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated from saved activity. Future payment dates and amounts are not guaranteed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінка за збереженими операціями. Дати й суми майбутніх платежів не гарантовані."
          }
        }
      }
    },
    "recurringLimitationsExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only positive expenses are considered. Transfers, refunds, income and future transactions are excluded. Changed amounts, missing periods and irregular groups may not be detected. The subscription label also requires every matched payment to use the Subscriptions category. Nothing is changed or scheduled automatically."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Враховуються лише додатні витрати. Перекази, повернення коштів, доходи та майбутні операції виключено. Зміни сум, пропущені періоди й нерегулярні групи можуть не визначатися. Позначка підписки також вимагає категорії «Підписки» в усіх відповідних платежах. Нічого не змінюється й не планується автоматично."
          }
        }
      }
    },
