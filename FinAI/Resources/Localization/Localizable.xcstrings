          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти. Чернетка залишилася на екрані; спробуйте ще раз."
          }
        }
      }
    },
    "debtInvalidInput": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a person, a positive amount and a valid currency. Debt and repayment dates cannot be in the future. A repayment must be on or after the debt date and cannot exceed the remaining debt. The due date cannot precede the debt date."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть особу, додатну суму й дійсну валюту. Дати боргу й погашення не можуть бути в майбутньому. Погашення має бути не раніше дати боргу й не перевищувати його залишок. Строк повернення не може передувати даті боргу."
          }
        }
      }
    },
    "debtChangedFailure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This debt changed. Cancel editing and reload before recording another repayment."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей борг змінився. Скасуйте редагування й оновіть дані перед записом наступного погашення."
          }
        }
      }
    },
    "assistantCategoryQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending by category"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрати за категоріями"
          }
        }
      }
    },
    "assistantWithoutRent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without rent…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без оренди…"
          }
        }
      }
    },
    "assistantChooseRentMerchant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the saved merchant for rent"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть збереженого продавця для оренди"
          }
        }
      }
    },
    "assistantRentMerchantExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the merchant whose payments represent rent. All expenses and refunds at that merchant will be excluded, including any payments unrelated to rent. Housing is not excluded automatically."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть продавця, платежі якому означають оренду. Усі витрати й повернення в цього продавця буде виключено, зокрема не пов’язані з орендою. Категорія «Житло» автоматично не виключається."
          }
        }
      }
    },
    "assistantExcludedMerchant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded merchant"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виключений продавець"
          }
        }
      }
    },
    "assistantExclusionExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All recorded expenses and refunds at this saved merchant are excluded. Other housing transactions remain included."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі збережені витрати й повернення коштів у цього продавця виключено. Інші операції за житло враховуються."
          }
        }
      }
    },
    "assistantRemoveExclusion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include the excluded merchant again"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знову включити виключеного продавця"
          }
        }
      }
    },
    "privacyPreviewHidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Financial details are hidden while the app is inactive."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фінансові дані приховано, поки програма неактивна."
          }
        }
      }
    },
    "settings": {
      "extractionState": "manual",
