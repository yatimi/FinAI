    "budgetPlanningExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly category limits across all accounts. Same-currency refunds received this month reduce spending; transfers and income are excluded. Limits repeat each calendar month. No currency conversion or money movement."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місячні ліміти категорій для всіх рахунків. Повернення в тій самій валюті цього місяця зменшують витрати; перекази й доходи виключено. Ліміти повторюються щомісяця. Без конвертації валют і переміщення коштів."
          }
        }
      },
      "extractionState": "manual"
    },
