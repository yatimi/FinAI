    "whatIfResultExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each calculation starts from the original forecast. A positive change means a higher net flow. The same forecast assumptions apply. This estimate does not tell you whether you can afford a purchase or when you’ll reach a savings goal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне обчислення починається з початкового прогнозу. Додатна зміна означає більший чистий потік. Припущення прогнозу залишаються тими самими. Ця оцінка не визначає, чи можете ви дозволити собі покупку або коли досягнете цілі заощаджень."
          }
        }
      }
    },
