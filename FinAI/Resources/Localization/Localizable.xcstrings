    "whatIfResultExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each calculation starts from the baseline, not the previous scenario. A positive change means higher projected net flow. This is a current-month estimate with the same assumptions as the forecast, not an affordability assessment or a prediction of goal completion."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне обчислення починається з базового прогнозу, а не попереднього сценарію. Додатна зміна означає більший прогнозований чистий потік. Це оцінка поточного місяця з тими самими припущеннями, що й прогноз, а не оцінка фінансової спроможності чи завершення цілі."
          }
        }
      }
    },
    "whatIfInvalidAmount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a positive amount using your regional number format."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть додатну суму у форматі чисел вашого регіону."
          }
        }
      }
    },
    "whatIfExpenseReductionLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can reduce only the estimated remaining expenses. Recorded expenses stay unchanged."
