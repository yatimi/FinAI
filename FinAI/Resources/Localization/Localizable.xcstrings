    "recurringDetectionExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are possible recurring payments, not confirmed agreements. FinAI looks for at least three payments with the same amount, merchant, account and currency. Weekly dates can differ by one day; monthly and yearly dates by three days."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це можливі регулярні платежі, а не підтверджені домовленості. FinAI шукає щонайменше три платежі з однаковою сумою, продавцем, рахунком і валютою. Щотижневі дати можуть відрізнятися на один день; щомісячні та щорічні — на три дні."
          }
        }
      }
    },
    "recurringEstimateExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates use your saved transactions. Future payment dates and amounts may change."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінки ґрунтуються на збережених операціях. Дати й суми майбутніх платежів можуть змінюватися."
          }
        }
      }
    },
    "recurringLimitationsExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only expenses greater than zero are included. Transfers, refunds, income and future-dated transactions are excluded. Changed amounts, missing payments and irregular schedules may go undetected. A payment is marked as a possible subscription only if all matching payments have the Subscriptions category. FinAI does not change or schedule payments."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Враховуються лише витрати більші за нуль. Перекази, повернення коштів, доходи й операції з майбутніми датами виключено. Зміни сум, пропущені платежі й нерегулярні дати можуть не визначатися. Позначка можливої підписки з’являється, лише якщо всі відповідні платежі мають категорію «Підписки». FinAI не змінює й не планує платежі."
          }
        }
      }
    },
