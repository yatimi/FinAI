    "planBudgetProgressUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending progress will appear once your transactions load and FinAI can calculate the totals."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогрес витрат з’явиться, коли операції завантажаться й FinAI зможе обчислити підсумки."
          }
        }
      }
    },
    "planBudgetSummaryExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Net spending is expenses minus refunds for the shown month. Each currency is kept separate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чисті витрати — це витрати мінус повернення коштів за показаний місяць. Кожна валюта враховується окремо."
          }
        }
      }
    },
    "planGoalSummaryExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter savings yourself. Goals are not account balances and do not tell you how much you can afford to save."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вносьте заощадження самостійно. Цілі не є балансами рахунків і не визначають, скільки ви можете дозволити собі відкладати."
          }
        }
      }
    },
