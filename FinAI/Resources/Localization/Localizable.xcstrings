          "stringUnit": {
            "state": "translated",
            "value": "The transactions match the statement’s opening and closing balances. Check their types, especially money in and transfers. FinAI uses booking dates; value dates and fee appendices do not create extra transactions. Nothing is saved until you confirm."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції відповідають початковому й кінцевому балансам виписки. Перевірте їхні типи, особливо надходження та перекази. FinAI використовує дати проведення; дати валютування й додатки з комісіями не створюють додаткових операцій. Нічого не зберігається без підтвердження."
          }
        }
      }
    },
    "statementCurrency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Statement currency: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта виписки: %@"
          }
        }
      }
