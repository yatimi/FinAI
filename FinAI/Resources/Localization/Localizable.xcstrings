    "whatIfNeedsForecast": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A baseline forecast is needed for this currency. Import the previous month’s transactions first."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї валюти потрібен базовий прогноз. Спочатку імпортуйте операції попереднього місяця."
          }
        }
      }
    },
    "whatIfExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try one unrecorded change in this month’s original currency. The amount adds to or reduces the baseline forecast; it does not change transactions, budgets, goals or account balances. Scenarios are temporary and are discarded when the forecast closes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте одну незбережену зміну в початковій валюті цього місяця. Сума збільшує або зменшує базовий прогноз; операції, бюджети, цілі й баланси рахунків не змінюються. Сценарії тимчасові й видаляються після закриття прогнозу."
          }
        }
      }
    },
    "whatIfBaselineSpending": {
