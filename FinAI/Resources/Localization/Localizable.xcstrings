    "whatIfExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a change that isn’t in your transactions yet, using this month’s currency. The amount adjusts the starting forecast without changing transactions, budgets, goals or account balances. The scenario is cleared when you close the forecast."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте зміну, якої ще немає серед операцій, у валюті цього місяця. Сума змінить початковий прогноз, але не операції, бюджети, цілі чи баланси рахунків. Сценарій зникне після закриття прогнозу."
          }
        }
      }
    },
