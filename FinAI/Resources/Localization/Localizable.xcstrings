    "pdfSizeLimitMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a PDF smaller than 10 MB with at most 100 pages and 2 MB of extracted text."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть PDF менше 10 МБ, що містить не більше 100 сторінок і 2 МБ видобутого тексту."
          }
        }
      }
    },
    "lockedPdfMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PDF is password protected. Choose an unlocked copy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей PDF захищено паролем. Виберіть незахищену копію."
          }
        }
      }
    },
    "pdfTextRequiredMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every PDF page must contain selectable text. Scanned or image-only statements are not supported yet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна сторінка PDF має містити текст, який можна виділити. Скановані виписки й виписки лише із зображеннями поки не підтримуються."
          }
        }
      }
    },
    "unsupportedStatementMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PDF format is not supported. Choose a complete German Sparkasse statement with the Datum / Erläuterung / Betrag EUR table."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей формат PDF не підтримується. Виберіть повну німецьку виписку Sparkasse з таблицею Datum / Erläuterung / Betrag EUR."
          }
        }
      }
    },
    "malformedStatementMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The statement could not be read completely. No data was imported. Choose a complete original PDF."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося повністю прочитати виписку. Дані не імпортовано. Виберіть повний оригінальний PDF."
          }
        }
      }
    },
    "statementBalanceMismatchMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transactions don’t match the statement’s opening and closing balances. Nothing was imported. Check that you selected the complete statement."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції не відповідають початковому й кінцевому балансам виписки. Нічого не імпортовано. Перевірте, чи вибрано повну виписку."
          }
        }
      }
    },
