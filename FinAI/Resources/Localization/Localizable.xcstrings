    "spendingBreakdownExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breakdowns show the current month, ordered by net spending. Refunds reduce spending in their recorded month and category. Merchant names use saved values. Transfers, income, adjustments and unknown transactions are excluded."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розподіл показує поточний місяць за спаданням чистих витрат. Повернення зменшують витрати у своєму місяці й категорії. Використовуються збережені назви продавців. Перекази, доходи, коригування й невідомі операції виключено."
          }
        }
      }
    },
    "staleRecurringPaymentExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected date has passed without a matching saved payment. This pattern may have ended, changed, or be missing imported data."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікувана дата минула без відповідного збереженого платежу. Платежі могли припинитися чи змінитися або бракує імпортованих даних."
          }
        }
      }
    },
