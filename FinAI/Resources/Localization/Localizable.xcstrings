          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва цілі"
          }
        }
      }
    },
    "goalOverdue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deadline has passed. Update the date or the amount saved."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кінцева дата минула. Оновіть дату або суму заощаджень."
          }
        }
      }
    },
    "goalPlanningExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your savings as you set money aside. Goals do not move money or change account balances. The monthly savings amount is rounded up and includes both this month and the deadline month. It does not tell you whether you can afford to save that amount."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вносьте заощадження, коли відкладаєте гроші. Цілі не переміщують кошти й не змінюють баланси рахунків. Щомісячна сума округлюється вгору; розрахунок включає цей місяць і місяць кінцевої дати. Він не визначає, чи можете ви дозволити собі відкладати цю суму."
          }
        }
      }
    },
    "goalRemainingAmount": {
      "extractionState": "manual",
      "localizations": {
