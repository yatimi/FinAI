    "merchantRuleMatchingExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules match whole words and ignore capitalization, punctuation and extra spaces. A short beginning of a description may match many transactions. Check each suggestion."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила зіставляють цілі слова без урахування великих і малих літер, розділових знаків і зайвих пробілів. Короткий початок опису може підходити до багатьох операцій. Перевіряйте кожну пропозицію."
          }
        }
      }
    },
    "merchantRules": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merchant rules"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила продавців"
          }
        }
      }
    },
    "merchantRulesExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rules apply to future imports before FinAI’s suggestions. An exact description match takes priority, followed by the longest matching beginning. Rules do not change transaction types, amounts or currencies."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші правила застосовуються до майбутніх імпортів перед пропозиціями FinAI. Пріоритет має точний збіг опису, потім — найдовший початок, що збігається. Правила не змінюють типи операцій, суми чи валюти."
          }
        }
      }
    },
    "merchantSuggestionsExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FinAI suggests merchants and categories on this device. Check them before saving. Changing a transaction’s type resets its suggested category."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "FinAI пропонує продавців і категорії на цьому пристрої. Перевірте їх перед збереженням. Зміна типу операції скидає запропоновану категорію."
          }
        }
      }
    },
