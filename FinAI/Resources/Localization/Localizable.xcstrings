    "goalInvalidInput": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a name, a target greater than zero, a currency and a deadline. Savings can be zero or more."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть назву, цільову суму більшу за нуль, валюту й кінцеву дату. Сума заощаджень може бути нульовою або більшою."
          }
        }
      }
    },
    "goalMonthlyContribution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required per month"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно щомісяця"
          }
        }
      }
    },
    "goalName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
